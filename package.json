{
  "name": "ai-film-studio",
  "displayName": "AI Film Studio",
  "description": "Quản lý pipeline làm phim AI: kịch bản → phân đoạn → cảnh → hồ sơ cảnh → prompt ảnh/video. Mỗi việc một tab, chọn model AI cho từng bước, dashboard tiến độ.",
  "version": "1.0.0",
  "publisher": "ngoctruongns",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/ngoctruongns/AI-film-studio.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/src/extension.js",
  "activationEvents": [
    "workspaceContains:.studio/project.yaml",
    "onWebviewPanel:aiFilmStudio.step",
    "onWebviewPanel:aiFilmStudio.dashboard"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aiFilmStudio",
          "title": "AI Film Studio",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "aiFilmStudio": [
        {
          "id": "aiFilmStudio.project",
          "name": "Dự án"
        },
        {
          "id": "aiFilmStudio.notes",
          "name": "Ghi chú @C / @T"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "aiFilmStudio.project",
        "contents": "Chưa có dự án phim.\n[Chọn thư mục dự án](command:aiFilmStudio.setProjectRoot)\n[Khởi tạo .studio/ cho thư mục này](command:aiFilmStudio.initProject)"
      }
    ],
    "commands": [
      {
        "command": "aiFilmStudio.openDashboard",
        "title": "Mở trạng thái dự án",
        "category": "AI Film Studio",
        "icon": "$(dashboard)"
      },
      {
        "command": "aiFilmStudio.refresh",
        "title": "Quét lại dự án",
        "category": "AI Film Studio",
        "icon": "$(refresh)"
      },
      {
        "command": "aiFilmStudio.pickStep",
        "title": "Chọn bước nhanh…",
        "category": "AI Film Studio",
        "icon": "$(play)"
      },
      {
        "command": "aiFilmStudio.setProjectRoot",
        "title": "Chọn thư mục dự án",
        "category": "AI Film Studio"
      },
      {
        "command": "aiFilmStudio.initProject",
        "title": "Khởi tạo .studio/ (cấu hình dự án)",
        "category": "AI Film Studio"
      },
      {
        "command": "aiFilmStudio.updateGitignore",
        "title": "Cập nhật .gitignore (khối của tool)",
        "category": "AI Film Studio"
      },
      {
        "command": "aiFilmStudio.startWork",
        "title": "Bắt đầu việc (git diff + git add -A)",
        "category": "AI Film Studio",
        "icon": "$(git-commit)"
      },
      {
        "command": "aiFilmStudio.editEpisodeList",
        "title": "Sửa danh sách tập (mã EP · số phát hành TAP)",
        "category": "AI Film Studio"
      },
      {
        "command": "aiFilmStudio.newEpisode",
        "title": "Thêm tập mới",
        "category": "AI Film Studio"
      },
      {
        "command": "aiFilmStudio.newSegment",
        "title": "Thêm phân đoạn (cấp mã)",
        "category": "AI Film Studio"
      },
      {
        "command": "aiFilmStudio.newSceneCode",
        "title": "Cấp mã cảnh mới",
        "category": "AI Film Studio"
      },
      {
        "command": "aiFilmStudio.runScript",
        "title": "Chạy script của dự án…",
        "category": "AI Film Studio",
        "icon": "$(terminal)"
      },
      {
        "command": "aiFilmStudio.setApiKey",
        "title": "Đặt khóa API cho model (mở Cài đặt AI)",
        "category": "AI Film Studio"
      },
      {
        "command": "aiFilmStudio.testModel",
        "title": "Thử kết nối model (mở Cài đặt AI)",
        "category": "AI Film Studio"
      },
      {
        "command": "aiFilmStudio.openSettings",
        "title": "Cài đặt AI (model, khóa, gán bước)",
        "category": "AI Film Studio",
        "icon": "$(settings-gear)"
      },
      {
        "command": "aiFilmStudio.editSceneTable",
        "title": "Sửa bảng cảnh dạng lưới",
        "category": "AI Film Studio",
        "icon": "$(table)"
      },
      {
        "command": "aiFilmStudio.endSession",
        "title": "Kết thúc phiên (nháp nhật ký STATE)",
        "category": "AI Film Studio",
        "icon": "$(debug-stop)"
      },
      {
        "command": "aiFilmStudio.openBlender",
        "title": "Blender của tập (file, shot, frame → cảnh)",
        "category": "AI Film Studio",
        "icon": "$(symbol-misc)"
      },
      {
        "command": "aiFilmStudio.openTarget",
        "title": "Mở tab (overview + các bước)",
        "category": "AI Film Studio",
        "icon": "$(open-preview)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "aiFilmStudio.openDashboard",
          "when": "view == aiFilmStudio.project",
          "group": "navigation@1"
        },
        {
          "command": "aiFilmStudio.startWork",
          "when": "view == aiFilmStudio.project",
          "group": "navigation@2"
        },
        {
          "command": "aiFilmStudio.endSession",
          "when": "view == aiFilmStudio.project",
          "group": "navigation@3"
        },
        {
          "command": "aiFilmStudio.openSettings",
          "when": "view == aiFilmStudio.project",
          "group": "navigation@4"
        },
        {
          "command": "aiFilmStudio.refresh",
          "when": "view == aiFilmStudio.project",
          "group": "navigation@5"
        },
        {
          "command": "aiFilmStudio.refresh",
          "when": "view == aiFilmStudio.notes",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "aiFilmStudio.openBlender",
          "when": "view == aiFilmStudio.project && viewItem == episode",
          "group": "inline@2"
        },
        {
          "command": "aiFilmStudio.editSceneTable",
          "when": "view == aiFilmStudio.project && viewItem == segment",
          "group": "inline@2"
        },
        {
          "command": "aiFilmStudio.newSegment",
          "when": "view == aiFilmStudio.project && viewItem == episode"
        },
        {
          "command": "aiFilmStudio.newSceneCode",
          "when": "view == aiFilmStudio.project && viewItem == segment"
        },
        {
          "command": "aiFilmStudio.editSceneTable",
          "when": "view == aiFilmStudio.project && viewItem == segment"
        },
        {
          "command": "aiFilmStudio.runScript",
          "when": "view == aiFilmStudio.project && viewItem =~ /^(episode|segment)$/"
        },
        {
          "command": "aiFilmStudio.pickStep",
          "when": "view == aiFilmStudio.project && viewItem =~ /^(project|episode|segment|scene)$/"
        }
      ]
    },
    "configuration": {
      "title": "AI Film Studio",
      "properties": {
        "aiFilmStudio.projectRoot": {
          "type": "string",
          "default": "",
          "description": "Đường dẫn tuyệt đối tới thư mục chính của dự án phim (chứa .studio/). Để trống = thư mục workspace đầu tiên có .studio/project.yaml."
        },
        "aiFilmStudio.machineProfile": {
          "type": "string",
          "default": "",
          "description": "Tên hồ sơ máy (vd. laptop, cong-ty, may-nha) — chỉ để ghi vào nhật ký chạy AI."
        },
        "aiFilmStudio.mediaRoot": {
          "type": "string",
          "default": "",
          "description": "Thư mục media (ảnh, video, audio) trên MÁY NÀY. Để trống = paths.media trong .studio/project.yaml."
        },
        "aiFilmStudio.claudePath": {
          "type": "string",
          "default": "",
          "description": "Đường dẫn tới CLI 'claude'. Để trống = tìm 'claude' trên PATH, rồi bản đi kèm extension Claude Code."
        },
        "aiFilmStudio.maxInputTokens": {
          "type": "number",
          "default": 60000,
          "description": "Trần token ngữ cảnh một lần chạy. Vượt thì hỏi lại trước khi gửi."
        },
        "aiFilmStudio.models": {
          "type": "array",
          "description": "Danh sách model trên MÁY NÀY (kiểu Continue). Khóa API không ghi ở đây — dùng lệnh 'Đặt khóa API'.",
          "default": [
            {
              "id": "claude-code",
              "provider": "claude-code",
              "title": "Claude Code (model mặc định)"
            },
            {
              "id": "claude-code-opus",
              "provider": "claude-code",
              "model": "opus",
              "title": "Claude Code · Opus"
            },
            {
              "id": "claude-code-sonnet",
              "provider": "claude-code",
              "model": "sonnet",
              "title": "Claude Code · Sonnet"
            },
            {
              "id": "claude-code-haiku",
              "provider": "claude-code",
              "model": "haiku",
              "title": "Claude Code · Haiku"
            }
          ],
          "items": {
            "type": "object",
            "required": [
              "id",
              "provider"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "Tên dùng trong .studio/models.yaml"
              },
              "title": {
                "type": "string"
              },
              "provider": {
                "type": "string",
                "enum": [
                  "claude-code",
                  "anthropic",
                  "openai",
                  "openai-compatible",
                  "gemini"
                ]
              },
              "model": {
                "type": "string",
                "description": "Tên model của nhà cung cấp"
              },
              "apiBase": {
                "type": "string",
                "description": "openai-compatible: vd. http://localhost:11434/v1 (Ollama)"
              },
              "secret": {
                "type": "string",
                "description": "Tên khóa trong SecretStorage (mặc định = provider)"
              },
              "maxOutputTokens": {
                "type": "number"
              },
              "contextWindow": {
                "type": "number"
              },
              "price": {
                "type": "object",
                "description": "USD / 1 triệu token",
                "properties": {
                  "input": {
                    "type": "number"
                  },
                  "output": {
                    "type": "number"
                  }
                }
              },
              "extraArgs": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "claude-code: tham số CLI thêm"
              }
            }
          }
        },
        "aiFilmStudio.stepModels": {
          "type": "object",
          "default": {},
          "description": "Gán model theo bước RIÊNG MÁY NÀY (ghi đè .studio/models.yaml). Ví dụ { \"am-thanh\": \"local-qwen\" }."
        },
        "aiFilmStudio.blenderPath": {
          "type": "string",
          "default": "",
          "description": "Blender dòng lệnh trên MÁY NÀY (vd. /usr/bin/blender, C:/Program Files/Blender Foundation/Blender 4.2/blender.exe). Để trống = máy này không chạy Blender."
        },
        "aiFilmStudio.blenderHost": {
          "type": "string",
          "default": "localhost",
          "description": "Host của addon MCP for Blender (Blender đang mở, có thể ở máy khác qua cổng chuyển tiếp)."
        },
        "aiFilmStudio.blenderPort": {
          "type": "number",
          "default": 9876,
          "description": "Cổng của addon MCP for Blender (giống BLENDER_PORT của blender_bridge.py)."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "test": "npm run compile && node out/test/smoke.js && node out/test/gui.js",
    "package": "npx --yes @vscode/vsce@3 package --allow-missing-repository --skip-license"
  },
  "dependencies": {
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.90.0",
    "jsdom": "^24.1.3",
    "typescript": "^5.4.0"
  }
}
